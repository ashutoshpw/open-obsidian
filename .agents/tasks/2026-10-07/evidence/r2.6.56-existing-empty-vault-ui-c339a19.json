  "scope": {
    "test": "tests::egui_opens_and_refreshes_an_existing_empty_vault_without_changing_its_tree",
    "change": "Open an existing vault that has zero Markdown notes but contains opaque configuration, arbitrary binary data, and a non-Markdown text file; refresh the note list and verify no vault or separate app-data writes.",
    "fixture_contents": [
      ".obsidian/app.json with an unrecognized option",
      "Assets/opaque.bin with arbitrary bytes",
      "README.txt with non-Markdown text",
      "A separate empty application-data directory"
    ],
    "checks": [
      "The Open vault action opens the canonical selected path and leaves the vault session with zero Markdown entries.",
      "The UI displays the selected vault, a zero-note count, and empty inspect/rename states.",
      "Refreshing the note list retains the open session and zero-note state.",
      "Full path/kind/byte snapshots of both the vault and separate app-data tree match before open, after open, after refresh, and after UI teardown."
    ]
  },
