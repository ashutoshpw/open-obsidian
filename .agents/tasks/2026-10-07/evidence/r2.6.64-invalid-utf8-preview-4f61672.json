  "scope": {
    "test": "tests::egui_invalid_utf8_note_preview_fails_closed_without_changing_vault_or_app_data",
    "file": "crates/ui-egui/src/lib.rs",
    "change": "Select a Markdown note containing invalid UTF-8 through the Note to inspect ComboBox, request its source preview, and verify the app fails closed without modifying the vault or separate app data.",
    "fixture": "A synthetic existing vault with a valid README.md, a BOM/CRLF Notes/Invalid UTF-8.md containing byte 0xff, and a separate app-data sentinel.",
    "checks": [
      "The invalid-UTF-8 Markdown path is discovered by the vault scan and remains selectable in the rendered UI.",
      "Source preview reports the explicit invalid-UTF-8 error and creates no partial or replacement-character preview.",
      "The invalid note's exact bytes and complete vault/app-data snapshots match their pre-open baseline after the error and UI teardown."
    ]
  },
  "harness_boundary": "The synthetic egui harness activates the ComboBox using AccessKit and inspects the resulting state. It does not certify native OS screen-reader behavior or an Obsidian reference-app round trip for invalid-UTF-8 Markdown.",
