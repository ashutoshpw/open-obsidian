  "scope": {
    "fixture": "fixtures/existing-vault.json",
    "test": "tests::egui_existing_vault_link_and_rename_previews_preserve_every_path_and_byte",
    "change": "Exercise the existing-vault link/transclusion and rename-preview UI against the arbitrary-content fixture, comparing the full filesystem tree before/after each UI operation and close.",
    "checks": [
      "The native UI resolves the fixture's wiki link and note embed and displays the two resolved references.",
      "The note transclusion report is populated from the existing fixture.",
      "The native UI builds a rename preview with the fixture's expected update count and does not apply the rename.",
      "Path names, entry types and all file bytes are identical after link/transclusion resolution, after rename preview, and after closing the UI.",
      "The app-data directory remains empty and outside the selected vault."
    ],
    "limits": [
      "This validates the selected native UI read-only flows and fixture only.",
      "Parent C01 and C01.2 remain open for the broader product read-only operation matrix and reference-application round trips.",
      "The fixture does not certify every supported or unknown vault content combination."
    ]
  },
