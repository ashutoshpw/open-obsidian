  "scope": {
    "fixture": "fixtures/existing-vault.json",
    "test": "ui_egui::tests::egui_refresh_after_external_note_edit_replaces_stale_preview_without_writing",
    "change": "Add native UI coverage for an in-place external edit to the currently previewed existing-vault note, refresh the session, and prove the refreshed source is visible without app writes.",
    "checks": [
      "Open Notes/Welcome.md through the existing-vault UI and verify the initial preview matches the fixture bytes.",
      "Simulate an external writer replacing the same path with a longer UTF-8 BOM and CRLF source; verify the deliberate external change is the only vault-tree difference and app data remains unchanged.",
      "Refresh through the UI, retain the selected path and note count, clear the stale preview, and show the updated source bytes and full size on the next preview.",
      "The refreshed vault remains equal to the expected post-edit snapshot through preview close and UI teardown; the separate app-data snapshot remains unchanged."
    ]
  },
