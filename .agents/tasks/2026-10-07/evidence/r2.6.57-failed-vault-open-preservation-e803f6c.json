  "scope": {
    "test": "tests::egui_keeps_the_open_vault_unchanged_when_another_selection_cannot_open",
    "change": "Attempt to open a regular file as another vault while a two-note existing vault is active, and prove the UI retains the active session after the open fails.",
    "checks": [
      "The production VaultSession::open rejects the selected regular file and the UI clears its opening/receiver state while displaying the safe error.",
      "The prior session remains selected at its canonical root with both Markdown entries and the existing-vault labels visible.",
      "Full path/kind/byte snapshots of the active vault and separate app-data tree, plus the selected file bytes, match before and after the failed open and after UI teardown."
    ],
    "harness_boundary": "The egui test harness injects the Open vault action and selected path; this case does not automate the native folder picker."
  },
