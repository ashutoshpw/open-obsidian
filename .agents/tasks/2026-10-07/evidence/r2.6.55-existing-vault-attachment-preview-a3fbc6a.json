  "scope": {
    "fixture": "fixtures/existing-vault.json",
    "test": "ui_egui::tests::egui_previews_existing_vault_attachment_without_changing_its_tree",
    "change": "Exercise attachment rendering through the existing-vault UI and compare complete vault and separate app-data snapshots before/after open, preview, and UI teardown.",
    "seeded_test_inputs": [
      "Materialize the existing-vault fixture, retaining its BOM/CRLF note, Obsidian configuration, and unknown binary files.",
      "Before taking the baseline snapshot, add a temporary note embedding the repository image fixture and add the image under Attachments."
    ],
    "checks": [
      "Opening the existing vault leaves all seeded paths and bytes unchanged and leaves separate app data unchanged.",
      "Click Resolve link status and wait for the production background operation; assert the embedded attachment resolves, produces decoded image pixels, and renders with its accessible alt text.",
      "Compare the entire vault tree and separate app-data tree after the UI operation and again after UI teardown."
    ]
  },
