    "test": "ui_egui::tests::egui_refresh_after_external_note_removal_clears_stale_preview_without_writing",
    "change": "Add cross-platform native UI acceptance for an external writer removing the selected note while its source preview is open, then refreshing and selecting a remaining note.",
    "checks": [
      "The fixture snapshot changes only by the deliberate external deletion of Notes/Welcome.md before refresh.",
      "The production refresh removes the deleted note from the listing, selects README.md as the remaining note, and clears the stale source preview and error state.",
      "The fallback README.md preview preserves the fixture source bytes; refresh, preview, close, and no-op teardown make no additional vault or app-data changes."
    ]
  },
