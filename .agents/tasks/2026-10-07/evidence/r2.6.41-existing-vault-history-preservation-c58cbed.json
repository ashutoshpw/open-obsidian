    "test": "tests::egui_history_review_requires_confirmation_and_preserves_protected_conflicts",
    "change": "Exercise history-retention review and app-data cleanup through the native egui UI while protecting an arbitrary-content existing vault.",
    "checks": [
      "Materialize the shared existing-vault fixture, including .obsidian settings, unknown paths and binary bytes, then add the history scenario's vault files and snapshot the complete vault tree.",
      "After history preview, compare the complete vault path/type/byte tree and confirm original history artifact bytes remain unchanged.",
      "After opening cleanup review and before confirmation, verify eligible recovery artifacts and the protected conflict artifact still exist and the complete vault tree is unchanged.",
      "After confirmed app-data cleanup, verify only eligible recovery artifacts were removed, protected conflict files and bytes remain, and the complete vault tree is unchanged.",
      "After closing the native UI, compare the complete vault tree again."
    ],
    "limits": [
      "This validates the focused native egui history review and cleanup flow against the shared existing-vault fixture.",
      "Parent C01 and C01.2 remain open for broader product read-only operations and reference-application round trips."
    ]
  },
