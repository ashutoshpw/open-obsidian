  "scope": "Add content-addressed vault snapshots, reject symlink traversal in reads, and bind a read-only rename preview to a stable whole-vault SHA-256 snapshot.",
  "behavior": [
    "Snapshots include sorted regular-file content revisions and symlink target revisions without following links.",
    "Reads reject symlinks at every path component, including links that resolve inside the vault.",
    "Rename previews resolve source-aware links from Markdown bytes captured between two matching snapshots; a changed snapshot fails closed.",
    "Preview verification rebuilds the plan and rejects stale snapshot or reference decisions without writing any vault bytes."
  ],
  "focused_tests": [
    "snapshots_hash_all_regular_files_and_notice_content_changes",
    "rename_preview_is_snapshot_bound_and_does_not_change_vault_bytes",
