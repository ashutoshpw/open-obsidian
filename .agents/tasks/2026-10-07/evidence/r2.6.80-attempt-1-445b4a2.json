  "change": "Add cross-platform egui coverage for externally moving a rendered PNG into another vault directory while retaining its basename, then refresh and verify a path-qualified embed does not resolve to the relocated file.",
  "external_attachment_move": {
    "focused_test": "egui_refresh_after_external_attachment_move_does_not_match_same_basename_elsewhere",
    "focused_test_conclusion": "passed on Ubuntu, macOS, and Windows",
    "behavior": "The test creates a one-note vault with pre-existing Attachments/ and Images/ directories, resolves and renders Attachments/photo.png, and opens the note source preview. It then moves the image outside OpenObsidian to Images/photo.png without changing its basename. Refresh keeps the vault and note active, clears stale report/preview/error/texture state, and preserves the exact post-move vault and separate app-data snapshots. Fresh resolution leaves the path-qualified Attachments/photo.png embed unresolved and NotRendered rather than matching the same-basename file in Images/. Both snapshots remain unchanged through teardown.",
    "workspace_test_conclusion": "cargo test --workspace --locked passed on Ubuntu, macOS, and Windows"
  },
