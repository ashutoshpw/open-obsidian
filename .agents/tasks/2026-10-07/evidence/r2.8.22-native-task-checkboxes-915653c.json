  "contract": "Allow task checkbox changes in complete supported Markdown previews, save only the changed task marker through revision-checked journaled vault writes, and preserve every other source byte.",
  "implementation": {
    "vault_layer": "A complete note source preview of at most 16 KiB carries the SHA-256 of the exact bytes read. Truncated previews carry no writable revision. VaultSession exposes the existing journaled writer to the native UI.",
    "ui_layer": "Complete supported Markdown previews use egui_commonmark's mutable renderer for task toggles. Writes include the preview revision. Unsupported and truncated previews remain read-only; stale writes preserve the external note and retain the attempted edit through the vault conflict history.",
    "reconciliation": "After a successful task write, watcher refresh preserves the preview only while the selected note still has the saved revision. Changed or missing notes clear it.",
    "source_integrity": "The fixture and egui interaction coverage verify BOM, CRLF, other task states, code literals, and unknown source text remain unchanged when one task is toggled."
  },
  "focused_tests": {
    "command": "cargo test --workspace --locked (GitHub Actions only)",
    "tests": [
      "tests::concurrent_edit_matrix_preserves_external_target_and_incoming_conflict",
      "tests::complete_note_source_preview_carries_a_revision_for_its_exact_bytes",
      "tests::egui_task_checkbox_toggle_saves_only_its_source_marker",
      "tests::egui_keeps_task_checkbox_read_only_for_unsupported_markdown",
      "tests::egui_keeps_task_checkbox_read_only_for_truncated_note_previews",
      "tests::egui_stale_task_checkbox_write_preserves_the_external_note_version"
    ],
    "result": "All six focused vault/UI tests and the full workspace suites passed on Ubuntu, macOS, and Windows in Rust CI logs. No local test, build, formatter, lint, or executable validation was used."
  },
