  "scope": "Apply revision-bound rename previews as journaled multi-file transactions, restore completed work on failure, and preserve/report external edits encountered during rollback.",
  "behavior": [
    "Revalidates the vault snapshot, source revision, destination availability and prepared reference edits before mutation.",
    "Moves the source note, writes only planned link target spans, and records prepared, committed or failed transaction journal entries.",
    "Before-images are preserved outside the vault; rollback restores only paths whose current revision still matches the transaction's written revision.",
    "An external edit found during rollback is left in place, copied to conflict history and reported as requiring recovery."
  ],
  "focused_tests": [
    "rename_transaction_moves_source_and_updates_only_planned_targets",
    "rename_refuses_an_existing_destination_without_changing_either_file",
    "failed_rename_restores_prior_writes_and_moves_source_back",
    "failed_rename_commit_journal_rolls_back_reference_writes_and_source_move",
    "rename_rollback_preserves_an_external_reference_edit"
  ],
