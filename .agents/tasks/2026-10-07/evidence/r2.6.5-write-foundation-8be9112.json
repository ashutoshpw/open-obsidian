  "scope": "Add the reusable revision-checked vault write, preservation and journal foundation for the R2.6.5 multi-file rename transaction.",
  "behavior": [
    "VaultStore requires an existing app-owned data directory outside the selected vault.",
    "Writes compare the caller's expected SHA-256 revision, preserve conflicting incoming bytes, preserve prior bytes before replacement, and append prepared/committed/failed journal entries.",
    "Writes use same-directory temporary files and platform replacement behavior; Windows uses a backup fallback because filesystem replacement semantics differ.",
    "A failed commit-journal append attempts a revision-guarded rollback; rollback leaves a changed file untouched and reports recovery-required state when restoration cannot be established."
  ],
  "focused_tests": [
    "revision_checked_writes_preserve_previous_bytes_and_journal_the_operation",
    "stale_writes_preserve_incoming_bytes_without_replacing_external_changes",
    "failed_atomic_write_keeps_original_and_preserves_incoming_bytes",
    "failed_commit_journal_rolls_back_a_new_file"
  ],
