    "fixture": "fixtures/existing-vault.json",
    "test": "tests::egui_existing_vault_uninstall_cleanup_selection_preserves_every_path_and_byte",
    "change": "Exercise the native uninstall cleanup choice controls against the shared arbitrary-content existing-vault fixture and prove that selecting preview-only choices performs no vault or app-data writes.",
    "checks": [
      "Materialize the fixture with Markdown, .obsidian settings, unknown paths and binary files, open it in place, and snapshot the complete vault and separate app-data path/type/byte trees.",
      "Select App cache, Stored credentials and Clean up recovery history one at a time; after each selection, compare the complete vault tree and app-data tree to their original snapshots.",
      "Verify the UI summarizes all selected local cleanup choices while making no deletion.",
      "Close the native UI and compare both complete trees again."
    ],
    "limits": [
      "Cleanup options are preview-only in the UI; this test does not invoke a package uninstaller or cleanup executor.",
      "This focused fixture flow does not complete parent C01 or the C01.2 reference-application round-trip matrix."
    ]
  },
