  "scope": "Add an Electron-compatible per-vault user-data service, restrict the managed directory to the current OS user, and expose existing vault history and conflict APIs through VaultSession.",
  "behavior": [
    "Uses the OS-specific OpenObsidian app-data root and the first 24 lowercase hex digits of SHA-256 over the lexically resolved vault root, matching the legacy Electron per-vault identity.",
    "Rejects unavailable or relative app-data roots, symlink/reparse-point directories and any managed history location inside the selected vault.",
    "Applies owner-only 0700 directory permissions on Unix and resets inherited Windows ACLs before granting full control to the current user's SID; access-control failures fail closed.",
    "VaultSession owns VaultStore and provides the engine boundary for history listing, retention plans, explicit cleanup, conflict inspection and explicit conflict resolution."
  ],
  "focused_tests": [
    "user_data::matches_electron_user_data_location_for_this_platform",
    "user_data::ignores_relative_xdg_home_and_uses_the_home_config_directory (Linux)",
    "user_data::matches_node_resolve_and_hashes_only_the_first_twenty_four_sha256_digits (Unix)",
    "user_data::matches_windows_node_resolve_for_drive_paths (Windows)",
    "user_data::creates_private_app_data_directories_with_owner_only_permissions (Unix)",
    "user_data::creates_app_data_directories_with_current_user_acl (Windows)",
    "user_data::extracts_the_current_user_sid_from_whoami_csv (Windows)"
  ],
