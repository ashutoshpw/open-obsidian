  "scope": {
    "test": "tests::egui_switches_between_existing_vaults_without_changing_either_tree",
    "file": "crates/ui-egui/src/lib.rs",
    "change": "Switch from an active existing vault to a second valid existing vault while the first vault's note source preview is open.",
    "checks": [
      "The second vault becomes the active canonical session with its distinct single Markdown note; the link and rename source selections point to that note.",
      "The old note preview and preview receiver/error are cleared when the session changes, and stale link resolutions are removed.",
      "Complete path/kind/byte snapshots of both vaults and a separate app-data tree remain unchanged after switching and UI teardown."
    ],
    "fixture_contents": [
      "First vault materialized from the existing-vault fixture.",
      "Second vault has an unrecognized Obsidian configuration option, opaque binary asset, and BOM/CRLF Markdown note.",
      "Separate app-data directory contains an opaque sentinel file."
    ],
    "harness_boundary": "The egui test harness injects the second selected path through the Open vault action; it does not automate the native folder picker."
  },
