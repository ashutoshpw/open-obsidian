  "scope": "Add validated conflict inspection and explicit keep-current/keep-incoming resolution to the Rust vault store.",
  "behavior": [
    "Conflict reads validate the history record and relative path, return incoming bytes, and calculate their SHA-256 revision.",
    "Keep Current removes only the selected validated conflict artifact and leaves vault bytes unchanged.",
    "Keep Incoming writes against the recorded current revision and removes the selected conflict only after a successful write.",
    "If the vault changes before Keep Incoming, the write is rejected and recovery artifacts remain available."
  ],
  "focused_tests": [
    "reads_and_explicitly_keeps_current_conflict_bytes",
    "keeps_incoming_conflict_only_when_the_recorded_current_revision_matches",
    "preserves_conflict_when_the_vault_changes_before_resolution",
    "refuses_to_inspect_or_resolve_a_conflict_for_another_path"
  ],
