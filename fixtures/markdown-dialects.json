{
  "schema_version": 1,
  "id": "fixture:c02-dialects",
  "name": "safe-markdown-preview-dialects",
  "supported_blocks": [
    "headings",
    "setext-headings",
    "tasks",
    "unordered-lists",
    "ordered-lists",
    "tables",
    "callouts",
    "fenced-code",
    "thematic-breaks",
    "inline-formatting",
    "wiki-links",
    "highlights"
  ],
  "visible_unsupported_blocks": [
    "footnotes",
    "math",
    "diagrams",
    "raw-html"
  ],
  "invariants": {
    "source_bytes_remain_authoritative": true,
    "preview_uses_text_content_for_untrusted_source": true,
    "code_and_diagram_execution": false,
    "unknown_syntax_is_not_silently_rewritten": true,
    "safe_html_projection_is_read_only": true
  },
  "task_editing": {
    "mutation_scope": "task-checkbox-marker-only",
    "requires_complete_valid_utf8_revision": true,
    "unsupported_or_truncated_previews_are_read_only": true,
    "conflicts_use_vault_recovery": true,
    "source": "\uFEFF# Task byte preservation\r\n\r\n- [ ] Toggle only this marker\r\n- [x] Preserve this checked marker\r\n\r\n~~~text\r\n- [ ] Marker inside code stays literal\r\n[[page]] ==mark==\r\n~~~\r\n\r\n%% Unknown extension remains literal.\r\n",
    "expected_after_toggle": "\uFEFF# Task byte preservation\r\n\r\n- [x] Toggle only this marker\r\n- [x] Preserve this checked marker\r\n\r\n~~~text\r\n- [ ] Marker inside code stays literal\r\n[[page]] ==mark==\r\n~~~\r\n\r\n%% Unknown extension remains literal.\r\n"
  },
  "callout_task_editing": {
    "source": "\uFEFF# Callout task byte preservation\r\n\r\n> [!NOTE] Action list\r\n> - [ ] Toggle only this callout marker\r\n> - [x] Preserve this checked callout marker\r\n\r\n%% Unknown extension remains literal.\r\n",
    "expected_after_toggle": "\uFEFF# Callout task byte preservation\r\n\r\n> [!NOTE] Action list\r\n> - [x] Toggle only this callout marker\r\n> - [x] Preserve this checked callout marker\r\n\r\n%% Unknown extension remains literal.\r\n"
  },
  "source_editing": {
    "mode": "explicit-source-draft",
    "requires_complete_valid_utf8_revision": true,
    "max_write_bytes": 16384,
    "writes_through_revision_checked_vault_writer": true,
    "preserves_bom_crlf_and_unrecognized_source": true,
    "unsupported_markdown_can_be_edited_as_plain_text": true,
    "source": "\uFEFF# Explicit source editing\r\n\r\nKeep this wiki embed literal: ![[Missing note]]\r\n\r\n%% Preserve this unknown extension.\r\n",
    "expected_after_edit": "\uFEFF# Explicit source editing\r\n\r\nKeep this wiki embed literal: ![[Missing note]]\r\n\r\n%% Preserve this unknown extension.\r\nSource edit"
  },
  "table_editing": {
    "mode": "explicit-source-draft",
    "edit": "change one table cell value",
    "requires_complete_valid_utf8_revision": true,
    "writes_through_revision_checked_vault_writer": true,
    "preserves_bom_crlf_and_table_delimiters": true,
    "source": "\uFEFF# Table source editing\r\n\r\n| Name | Value |\r\n| --- | ---: |\r\n| item | before |\r\n",
    "expected_after_edit": "\uFEFF# Table source editing\r\n\r\n| Name | Value |\r\n| --- | ---: |\r\n| item | after |\r\n"
  },
  "rust_preview": {
    "renderer": "egui_commonmark 0.25.0",
    "rendered_blocks": [
      "headings",
      "setext-headings",
      "tasks",
      "unordered-lists",
      "ordered-lists",
      "tables",
      "standard-alert-callouts",
      "fenced-code",
      "thematic-breaks",
      "inline-formatting",
      "footnotes",
      "inline-and-display-math",
      "safe-inline-html-break",
      "inline-highlights"
    ],
    "vault_context_rendered_blocks": ["simple-resolved-wiki-links"],
    "source_only_blocks": [
      "legacy-math-delimiters",
      "diagrams",
      "unknown-or-active-raw-html",
      "unresolved-or-complex-wiki-links",
      "block-context-wiki-links",
      "table-context-wiki-links",
      "task-list-wiki-links",
      "complex-inline-highlights"
    ],
    "resolved_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "Read [[Plans/Project|the plan]] next.",
      "target_path": "Plans/Project.md",
      "target_source": "# Project plan\nThe resolved target note.",
      "expected_label": "the plan",
      "expected_navigation_path": "Plans/Project.md",
      "preserves_source_bytes": true
    },
    "unresolved_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "Read [[Missing]] next.",
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false
    },
    "ambiguous_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "Read [[Project]] next.",
      "candidate_paths": ["Plans/Project.md", "Archive/Project.md"],
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false
    },
    "stale_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "Read [[Plans/Project|the plan]] next.",
      "target_path": "Plans/Project.md",
      "resolution_revision": "older-than-preview-source",
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "expected_refresh_message": "Read the note preview again to refresh resolved wiki links.",
      "remains_clickable": false,
      "preserves_source_bytes": true
    },
    "embedded_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "Read ![[Plans/Project]] next.",
      "target_path": "Plans/Project.md",
      "target_source": "# Project plan\n\n## Overview\nThe resolved target note.",
      "expected_link_kind": "embed",
      "expected_subpath": null,
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false,
      "preserves_source_bytes": true
    },
    "subpath_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "Read [[Plans/Project#Overview]] next.",
      "target_path": "Plans/Project.md",
      "target_source": "# Project plan\n\n## Overview\nThe resolved target note.",
      "expected_link_kind": "wiki_link",
      "expected_subpath": "Overview",
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false,
      "preserves_source_bytes": true
    },
    "non_markdown_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "Read [[Boards/Research.canvas]] next.",
      "target_path": "Boards/Research.canvas",
      "target_source": "{\"nodes\":[],\"edges\":[]}",
      "expected_link_kind": "wiki_link",
      "expected_subpath": null,
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false,
      "preserves_source_bytes": true
    },
    "mixed_formatting_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "Read **[[Plans/Project]]** next.",
      "target_path": "Plans/Project.md",
      "target_source": "# Project plan\nThe resolved target note.",
      "expected_link_kind": "wiki_link",
      "expected_subpath": null,
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false,
      "preserves_source_bytes": true
    },
    "block_context_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "- Read [[Plans/Project]] next.",
      "target_path": "Plans/Project.md",
      "target_source": "# Project plan\nThe resolved target note.",
      "expected_link_kind": "wiki_link",
      "expected_subpath": null,
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false,
      "preserves_source_bytes": true
    },
    "table_context_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "| Plan |\n| --- |\n| [[Plans/Project]] |",
      "target_path": "Plans/Project.md",
      "target_source": "# Project plan\nThe resolved target note.",
      "expected_link_kind": "wiki_link",
      "expected_subpath": null,
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false,
      "preserves_source_bytes": true
    },
    "task_list_wiki_link_preview": {
      "source_path": "Index.md",
      "source": "- [ ] Review [[Plans/Project]]",
      "target_path": "Plans/Project.md",
      "target_source": "# Project plan\nThe resolved target note.",
      "expected_link_kind": "wiki_link",
      "expected_subpath": null,
      "expected_fallback": "Unsupported Markdown (wiki links); showing the source as written.",
      "remains_clickable": false,
      "expected_task_checkbox_interactive": false,
      "preserves_source_bytes": true
    },
    "safe_inline_html": {
      "rendered_tags": ["<br>", "<br/>", "<br />"],
      "unsupported_html": "Keep all other inline and block HTML visible as original source."
    },
    "fallback": "If a known source-only construct is present, show the bounded original source slice as monospace text and name the unsupported syntax. Do not write or normalize the source.",
    "cases": [
      {
        "id": "commonmark-basics",
        "source": "# Heading\n\nSubheading\n---\n\n- [x] Task\n\n| Name | Value |\n| --- | --- |\n| note | 3 |\n\n> [!NOTE] Safe callout\n\n~~~rust\nfn main() {}\n~~~\n\n**bold** ~~strike~~",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": []
      },
      {
        "id": "footnote",
        "source": "A reference[^one].\n\n[^one]: Original footnote body.",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": []
      },
      {
        "id": "inline-and-display-math",
        "source": "Inline $a + b$.\n\n$$\nc = 3\n$$",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": []
      },
      {
        "id": "legacy-delimited-math",
        "source": "Legacy \\[x^2\\] and \\(y+1\\).",
        "expected_disposition": "show-source",
        "unsupported_syntax": ["legacy-math"]
      },
      {
        "id": "mermaid-diagram",
        "source": "~~~mermaid title=flow\nflowchart TD\n  A --> B\n~~~",
        "expected_disposition": "show-source",
        "unsupported_syntax": ["diagrams"]
      },
      {
        "id": "raw-html",
        "source": "<script>alert('not executed')</script>",
        "expected_disposition": "show-source",
        "unsupported_syntax": ["raw-html"]
      },
      {
        "id": "safe-html-inline-break",
        "source": "First line<br>Second line.",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": [],
        "expected_native_render_source": "First line  \nSecond line."
      },
      {
        "id": "safe-html-inline-break-self-closing",
        "source": "First<br/>Second",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": [],
        "expected_native_render_source": "First  \nSecond"
      },
      {
        "id": "safe-html-inline-break-spaced-self-closing",
        "source": "First<br />Second",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": [],
        "expected_native_render_source": "First  \nSecond"
      },
      {
        "id": "safe-html-inline-break-before-crlf",
        "source": "First<br>\r\nSecond",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": [],
        "expected_native_render_source": "First  \nSecond"
      },
      {
        "id": "html-break-with-attributes-remains-source",
        "source": "First<br class=wide>Second",
        "expected_disposition": "show-source",
        "unsupported_syntax": ["raw-html"]
      },
      {
        "id": "wiki-link",
        "source": "See [[Project plan|the plan]].",
        "expected_disposition": "show-source",
        "unsupported_syntax": ["wiki-links"]
      },
      {
        "id": "highlight",
        "source": "Keep ==this phrase== visible.",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": [],
        "expected_highlight_texts": ["this phrase"]
      },
      {
        "id": "multiple-plain-highlights",
        "source": "Keep ==this phrase== and ==that phrase== visible.",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": [],
        "expected_highlight_texts": ["this phrase", "that phrase"]
      },
      {
        "id": "highlight-mixed-with-markdown-formatting",
        "source": "**Keep** ==this phrase== visible.",
        "expected_disposition": "show-source",
        "unsupported_syntax": ["highlights"]
      },
      {
        "id": "escaped-highlight-opener-is-literal",
        "source": "Keep \\==this phrase== as literal text.",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": []
      },
      {
        "id": "even-backslash-run-keeps-highlight-active",
        "source": "Keep \\\\==this phrase== as an active highlight.",
        "expected_disposition": "show-source",
        "unsupported_syntax": ["highlights"]
      },
      {
        "id": "mixed-supported-and-unsupported",
        "source": "# Kept as source\n\n<script>unsafe()</script>\n\nA formula $x$.",
        "expected_disposition": "show-source",
        "unsupported_syntax": ["raw-html"]
      },
      {
        "id": "literal-markers-inside-code",
        "source": "Inline \u0060[[page]] ==mark== <script>[^one] $x$ \\(y\\)\u0060.\n\n~~~text\n[[page]] ==mark== <script>[^one] $x$ \\(y\\)\n~~~",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": []
      },
      {
        "id": "legacy-math-inside-indented-code",
        "source": "    \\(x+1\\)\n",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": []
      },
      {
        "id": "unknown-markup-remains-literal",
        "source": "%% Unknown extension text stays in source.",
        "expected_disposition": "render-markdown",
        "unsupported_syntax": []
      }
    ]
  }
}
