          "incoming_bytes_utf8": "\ufefftitle: first-incoming\r\n",
          "expected_target_bytes_utf8": "\ufefftitle: first-incoming\r\n",
          "expected_previous_recovery_bytes_utf8": "\ufefftitle: first-original\r\n",
          "expected_incoming_recovery_bytes_utf8": "\ufefftitle: first-incoming\r\n"
        },
        {
          "relative_path": "second.md",
          "write_outcome": "failed",
          "initial_bytes_utf8": "\ufeffstatus: second-original\r\n",
          "incoming_bytes_utf8": "\ufeffstatus: second-incoming\r\n",
          "expected_target_bytes_utf8": "\ufeffstatus: second-original\r\n",
          "expected_failed_history_bytes_utf8": "\ufeffstatus: second-incoming\r\n",
          "expected_previous_recovery_bytes_utf8": "\ufeffstatus: second-original\r\n",
          "expected_incoming_recovery_bytes_utf8": "\ufeffstatus: second-incoming\r\n"
        }
      ]
    },
    {
