      "applicable_platforms": ["Windows"],
      "old_relative_path": "Notes/Title.md",
      "new_relative_path": "Notes/title.md",
      "initial_bytes_utf8": "\ufefftitle: preserved\r\nbody: untouched\r\n",
      "expected_content_bytes_utf8": "\ufefftitle: preserved\r\nbody: untouched\r\n",
      "expected_content_write": false,
      "expected_content_revision_unchanged": true,
