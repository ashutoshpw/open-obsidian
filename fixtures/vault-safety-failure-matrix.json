      "outside_target_bytes_utf8": "\ufeffstatus: external\r\n",
      "incoming_bytes_utf8": "\ufeffstatus: candidate\r\n",
      "expected_target_bytes_utf8": "\ufeffstatus: external\r\n",
      "expected_recorded_kind": "symlink",
      "expected_read_error": "symlink",
      "expected_write_error": "symlink"
    },
    {
      "id": "case-only-rename",
      "fault_stage": null,
