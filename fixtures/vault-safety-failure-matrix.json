          "expected_previous_recovery_bytes_utf8": "\ufeffstatus: second-original\r\n",
          "expected_incoming_recovery_bytes_utf8": "\ufeffstatus: second-incoming\r\n"
        }
      ]
    },
    {"id": "cloud-placeholder", "fault_stage": null, "expected_outcome": "do-not-follow-unknown-link"},
    {
      "id": "symlink",
      "fault_stage": null,
      "expected_outcome": "record-link-and-deny-traversal",
