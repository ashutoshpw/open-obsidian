      "valid_relative_path": "Notes/Kept.md",
      "initial_bytes_utf8": "\ufeffstatus: saved\r\n",
      "incoming_bytes_utf8": "\ufeffstatus: blocked\r\n",
      "expected_preserved_version_utf8": "\ufeffstatus: saved\r\n",
      "expected_read_error": "Windows-reserved",
      "expected_write_error": "Windows-reserved",
      "expected_journal_entries": 0
