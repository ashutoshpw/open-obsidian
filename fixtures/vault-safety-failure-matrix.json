    {"id": "case-only-rename", "fault_stage": null, "expected_outcome": "observe-path-change-without-content-rewrite"},
    {"id": "windows-reserved-name", "fault_stage": null, "expected_outcome": "deny-on-windows"},
    {"id": "unicode-normalization", "fault_stage": null, "expected_outcome": "preserve-original-bytes"}
