{
  "schema_version": 1,
  "id": "fixture:sync-failure-matrix",
  "purpose": "Portable failure classes and their non-destructive VaultStore outcomes.",
  "scenarios": [
    {
      "id": "disk-full",
      "fault_stage": "before-temp-write",
      "expected_outcome": "preserve-incoming-as-failed-history",
      "injected_error": "injected disk-full fault before the target temporary write",
      "applicable_platforms": ["macOS", "Windows", "Linux"],
      "initial_bytes_utf8": "\ufeffstatus: saved\r\n",
      "incoming_bytes_utf8": "\ufeffstatus: candidate\r\n",
      "expected_target_bytes_utf8": "\ufeffstatus: saved\r\n",
      "expected_failed_history_bytes_utf8": "\ufeffstatus: candidate\r\n",
      "expected_previous_recovery_bytes_utf8": "\ufeffstatus: saved\r\n",
      "expected_incoming_recovery_bytes_utf8": "\ufeffstatus: candidate\r\n"
    },
    {
      "id": "permission-loss",
      "fault_stage": "before-replace",
      "expected_outcome": "preserve-incoming-as-failed-history",
      "injected_error": "injected permission loss before target replacement",
      "applicable_platforms": ["macOS", "Windows", "Linux"],
      "initial_bytes_utf8": "\ufeffstatus: saved\r\n",
      "incoming_bytes_utf8": "\ufeffstatus: candidate\r\n",
      "expected_target_bytes_utf8": "\ufeffstatus: saved\r\n",
      "expected_failed_history_bytes_utf8": "\ufeffstatus: candidate\r\n",
      "expected_previous_recovery_bytes_utf8": "\ufeffstatus: saved\r\n",
      "expected_incoming_recovery_bytes_utf8": "\ufeffstatus: candidate\r\n"
    },
    {
      "id": "concurrent-edit",
      "fault_stage": "after-base-read-before-write",
      "expected_outcome": "preserve-incoming-as-conflict",
      "applicable_platforms": ["macOS", "Windows", "Linux"],
      "relative_path": "Notes/Concurrent.md",
      "initial_bytes_utf8": "\ufeffstatus: saved\r\n",
      "external_bytes_utf8": "\ufeffstatus: external-edit\r\n",
      "incoming_bytes_utf8": "\ufeffstatus: editor-candidate\r\n",
      "expected_target_bytes_utf8": "\ufeffstatus: external-edit\r\n",
      "expected_conflict_bytes_utf8": "\ufeffstatus: editor-candidate\r\n",
      "expected_conflict_protected": true,
      "expected_journal_state": "conflict"
    },
    {
      "id": "delete-versus-edit",
      "fault_stage": "after-base-read-before-delete",
      "expected_outcome": "preserve-incoming-as-conflict",
      "applicable_platforms": ["macOS", "Windows", "Linux"],
      "relative_path": "Notes/Deleted.md",
      "initial_bytes_utf8": "\ufeffstatus: saved\r\n",
      "incoming_bytes_utf8": "\ufeffstatus: editor-candidate\r\n",
      "expected_target_bytes_utf8": null,
      "expected_conflict_bytes_utf8": "\ufeffstatus: editor-candidate\r\n",
      "expected_conflict_protected": true,
      "expected_journal_state": "conflict"
    },
    {
      "id": "rename-versus-edit",
      "fault_stage": "after-base-read-before-external-rename",
      "expected_outcome": "preserve-incoming-as-conflict",
      "applicable_platforms": ["macOS", "Windows", "Linux"],
      "relative_path": "Notes/BeforeRename.md",
      "renamed_path": "Archive/AfterRename.md",
      "initial_bytes_utf8": "\ufeffstatus: saved\r\n",
      "incoming_bytes_utf8": "\ufeffstatus: editor-candidate\r\n",
      "expected_target_bytes_utf8": null,
      "expected_renamed_path_bytes_utf8": "\ufeffstatus: saved\r\n",
      "expected_conflict_bytes_utf8": "\ufeffstatus: editor-candidate\r\n",
      "expected_conflict_protected": true,
      "expected_journal_state": "conflict"
    },
    {
      "id": "partial-sync",
      "fault_stage": "before-replace",
      "fault_path": "second.md",
      "expected_outcome": "journal-batch-and-preserve-failed-version",
