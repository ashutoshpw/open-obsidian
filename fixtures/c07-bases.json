{
  "schema_version": 1,
  "id": "fixture:c07-bases",
  "description": "Supported JSON and native YAML definitions, unknown fields, evaluation, and embedded source spans.",
  "supported_cases": [
    {
      "id": "json-supported-definition",
      "format": "json",
      "source": {
        "version": 1,
        "views": [
          {
            "type": "table",
            "name": "Open",
            "filter": {
              "kind": "all",
              "filters": [
                {"kind": "comparison", "field": "status", "operator": "equals", "value": "open"},
                {"kind": "comparison", "field": "priority", "operator": "gte", "value": 2}
              ]
            },
            "sort": [{"field": "priority", "direction": "desc"}],
            "groupBy": "owner",
            "limit": 1,
            "formulas": {"pathLabel": "file.path", "isOpen": "true", "answer": "42", "quoted": "\"hello\""},
            "unknownView": {"keep": "view-field"}
          },
          {"type": "list", "name": "List", "properties": ["status"]},
          {"type": "cards", "name": "Cards", "cardSize": "medium"}
        ],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Open",
      "rows": [
        {"path": "folder/a.md", "properties": {"status": "open", "priority": 1, "owner": "Ada"}},
        {"path": "folder/b.md", "properties": {"status": "open", "priority": 2, "owner": "Bea", "metadata": {"labels": ["one"]}}},
        {"path": "folder/c.md", "properties": {"status": "done", "priority": 3, "owner": "Cal"}}
      ],
      "expected": {
        "paths": ["folder/b.md"],
        "formula": {"name": "pathLabel", "value": "folder/b.md"},
        "group_names": ["Bea"],
        "view_types": ["table", "list", "cards"]
      }
    },
    {
      "id": "native-yaml-supported-definition",
      "format": "yaml",
      "source": "filters:\n  and:\n    - status == \"open\"\n    - priority >= 2\nformulas:\n  pathLabel: file.path\nproperties:\n  status:\n    displayName: Status\nviews:\n  - type: table\n    name: Open items\n    limit: 1\n    groupBy:\n      property: owner\n      direction: DESC\n    filters:\n      and:\n        - status == \"open\"\n    order:\n      - priority\n    unknownView: keep-view-field\n  - type: list\n    name: All items\nunknownRoot:\n  keep: root-field\n",
      "view": "Open items",
      "rows": [
        {"path": "a.md", "properties": {"status": "open", "priority": 3, "owner": "Ada"}},
        {"path": "b.md", "properties": {"status": "open", "priority": 2, "owner": "Bea"}},
        {"path": "c.md", "properties": {"status": "done", "priority": 4, "owner": "Cal"}}
      ],
      "expected": {
        "paths": ["b.md"],
        "formula": {"name": "pathLabel", "value": "b.md"},
        "group_names": ["Bea"],
        "view_types": ["table", "list"]
      }
    }
  ],
  "unsupported_native_filter": {
    "id": "native-unsupported-filter-is-not-applied",
    "source": "filters: file.hasTag(\"open\")\nviews:\n  - type: list\n    name: Notes\n",
    "view": "Notes",
    "rows": [
      {"path": "closed.md", "properties": {"status": "closed"}}
    ],
    "expected": {
      "paths": ["closed.md"],
      "issue_kind": "invalid-filter",
      "issue_message": "Native Bases filter is outside the supported comparison subset: file.hasTag(\"open\")"
    }
  },
  "filter_operator_case": {
    "id": "json-filter-operator-subset",
    "source": {
      "version": 1,
      "views": [
        {
          "type": "list",
          "name": "Matching notes",
          "filter": {
            "kind": "all",
            "filters": [
              {"kind": "comparison", "field": "tags", "operator": "contains", "value": "review"},
              {"kind": "comparison", "field": "title", "operator": "contains", "value": "beta"},
              {"kind": "comparison", "field": "priority", "operator": "gt", "value": 1},
              {"kind": "comparison", "field": "priority", "operator": "gte", "value": 3},
              {"kind": "comparison", "field": "priority", "operator": "lt", "value": 4},
              {"kind": "comparison", "field": "priority", "operator": "lte", "value": 3},
              {"kind": "comparison", "field": "priority", "operator": "not-equals", "value": 9},
              {"kind": "not", "filter": {"kind": "comparison", "field": "status", "operator": "equals", "value": "closed"}},
              {"kind": "any", "filters": [
                {"kind": "comparison", "field": "status", "operator": "equals", "value": "open"},
                {"kind": "comparison", "field": "status", "operator": "not-equals", "value": "archived"}
              ]}
            ]
          }
        }
      ]
    },
    "view": "Matching notes",
    "rows": [
      {"path": "match.md", "properties": {"status": "open", "priority": 3, "tags": ["review"], "title": "Beta task"}},
      {"path": "closed.md", "properties": {"status": "closed", "priority": 3, "tags": ["review"], "title": "Beta task"}},
      {"path": "high.md", "properties": {"status": "open", "priority": 5, "tags": ["review"], "title": "Beta task"}}
    ],
    "expected": {
      "paths": ["match.md"]
    }
  },
  "numeric_sort_case": {
    "id": "json-numeric-sort-uses-number-order",
    "source": {
      "version": 1,
      "views": [{"type": "table", "name": "Decimal order", "sort": [{"field": "ratio"}]}]
    },
    "view": "Decimal order",
    "rows": [
      {"path": "half.md", "properties": {"ratio": 0.5}},
      {"path": "quarter.md", "properties": {"ratio": 0.25}},
      {"path": "three-quarters.md", "properties": {"ratio": 0.75}}
    ],
    "expected": {"paths": ["quarter.md", "half.md", "three-quarters.md"]}
  },
  "numeric_filter_case": {
    "id": "json-numeric-filter-uses-number-order",
    "source": {
      "version": 1,
      "views": [{
        "type": "list",
        "name": "Above decimal threshold",
        "filter": {"kind": "comparison", "field": "ratio", "operator": "gt", "value": 0.3}
      }]
    },
    "view": "Above decimal threshold",
    "rows": [
      {"path": "quarter.md", "properties": {"ratio": 0.25}},
      {"path": "half.md", "properties": {"ratio": 0.5}},
      {"path": "three-quarters.md", "properties": {"ratio": 0.75}}
    ],
    "expected": {"paths": ["half.md", "three-quarters.md"]}
  },
  "file_derived_fields_case": {
    "id": "file-derived-fields-use-basename",
    "source": {
      "version": 1,
      "views": [{"type": "table", "name": "File fields", "sort": [{"field": "file.ext"}]}]
    },
    "view": "File fields",
    "rows": [
      {"path": "folder.v1/no-extension", "properties": {}},
      {"path": "folder.v1/note.md", "properties": {}},
      {"path": "folder.v1/archive.tar.gz", "properties": {}}
    ],
    "expected": {
      "paths": ["folder.v1/no-extension", "folder.v1/archive.tar.gz", "folder.v1/note.md"],
      "fields": {
        "folder.v1/no-extension": {"name": "no-extension", "ext": ""},
        "folder.v1/note.md": {"name": "note.md", "ext": "md"},
        "folder.v1/archive.tar.gz": {"name": "archive.tar.gz", "ext": "gz"}
      }
    }
  },
  "evaluation_edge_cases": [
    {
      "id": "missing-and-explicit-null-sort-separately",
      "source": {
        "version": 1,
        "views": [{
          "type": "table",
          "name": "Missing and null",
          "sort": [{"field": "marker", "direction": "asc"}],
          "unknownView": {"keep": "view-field"}
        }],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Missing and null",
      "rows": [
        {"path": "value.md", "properties": {"marker": "value"}},
        {"path": "null.md", "properties": {"marker": null}},
        {"path": "missing.md", "properties": {}}
      ],
      "expected": {
        "paths": ["missing.md", "null.md", "value.md"],
        "group_names": []
      }
    },
    {
      "id": "mixed-integer-and-float-numeric-order",
      "source": {
        "version": 1,
        "views": [{
          "type": "table",
          "name": "Mixed numeric order",
          "sort": [{"field": "score", "direction": "asc"}],
          "unknownView": {"keep": "view-field"}
        }],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Mixed numeric order",
      "rows": [
        {"path": "int-two.md", "properties": {"score": 2}},
        {"path": "float-one-point-five.md", "properties": {"score": 1.5}},
        {"path": "float-two.md", "properties": {"score": 2.0}},
        {"path": "int-one.md", "properties": {"score": 1}}
      ],
      "expected": {
        "paths": ["int-one.md", "float-one-point-five.md", "float-two.md", "int-two.md"],
        "group_names": []
      }
    },
    {
      "id": "mixed-integer-and-float-order-preserves-precision-above-2-to-53",
      "source": {
        "version": 1,
        "views": [{
          "type": "table",
          "name": "Large mixed numeric order",
          "sort": [{"field": "score", "direction": "asc"}],
          "unknownView": {"keep": "view-field"}
        }],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Large mixed numeric order",
      "rows": [
        {"path": "a-integer-next.md", "properties": {"score": 9007199254740993}},
        {"path": "z-float-below.md", "properties": {"score": 9007199254740992.0}},
        {"path": "b-integer-below.md", "properties": {"score": 9007199254740992}}
      ],
      "expected": {
        "paths": ["b-integer-below.md", "z-float-below.md", "a-integer-next.md"],
        "group_names": []
      }
    },
    {
      "id": "mixed-integer-float-filter-preserves-precision-above-2-to-53",
      "source": {
        "version": 1,
        "views": [{
          "type": "list",
          "name": "Above large float threshold",
          "filter": {
            "kind": "comparison",
            "field": "score",
            "operator": "gt",
            "value": 9007199254740992.0
          },
          "unknownView": {"keep": "view-field"}
        }],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Above large float threshold",
      "rows": [
        {"path": "integer-next.md", "properties": {"score": 9007199254740993}},
        {"path": "float-threshold.md", "properties": {"score": 9007199254740992.0}},
        {"path": "integer-threshold.md", "properties": {"score": 9007199254740992}}
      ],
      "expected": {
        "paths": ["integer-next.md"],
        "group_names": []
      }
    },
    {
      "id": "array-contains-compares-large-integer-and-float-exactly",
      "source": {
        "version": 1,
        "views": [{
          "type": "list",
          "name": "Contains exact large number",
          "filter": {
            "kind": "comparison",
            "field": "numbers",
            "operator": "contains",
            "value": 9007199254740992.0
          },
          "unknownView": {"keep": "view-field"}
        }],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Contains exact large number",
      "rows": [
        {"path": "integer-next.md", "properties": {"numbers": [9007199254740993]}},
        {"path": "float-match.md", "properties": {"numbers": [9007199254740992.0]}},
        {"path": "integer-match.md", "properties": {"numbers": [9007199254740992]}}
      ],
      "expected": {
        "paths": ["float-match.md", "integer-match.md"],
        "group_names": []
      }
    },
    {
      "id": "integer-valued-float-limit-truncates-rows",
      "source": {
        "version": 1,
        "views": [{
          "type": "table",
          "name": "Float limit",
          "sort": [{"field": "rank", "direction": "asc"}],
          "limit": 1.0,
          "unknownView": {"keep": "view-field"}
        }],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Float limit",
      "rows": [
        {"path": "second.md", "properties": {"rank": 2}},
        {"path": "first.md", "properties": {"rank": 1}}
      ],
      "expected": {
        "paths": ["first.md"],
        "group_names": []
      }
    },
    {
      "id": "tied-sort-keys-use-ordinary-path-order",
      "source": {
        "version": 1,
        "views": [{
          "type": "table",
          "name": "Path tie",
          "sort": [{"field": "rank", "direction": "asc"}],
          "unknownView": {"keep": "view-field"}
        }],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Path tie",
      "rows": [
        {"path": "a2.md", "properties": {"rank": 1}},
        {"path": "a10.md", "properties": {"rank": 1}}
      ],
      "expected": {
        "paths": ["a10.md", "a2.md"],
        "group_names": []
      }
    },
    {
      "id": "groups-preserve-first-seen-order-after-limit",
      "source": {
        "version": 1,
        "views": [{
          "type": "table",
          "name": "Limited groups",
          "sort": [{"field": "rank", "direction": "asc"}],
          "groupBy": "team",
          "limit": 3,
          "unknownView": {"keep": "view-field"}
        }],
        "unknownRoot": {"keep": "root-field"}
      },
      "view": "Limited groups",
      "rows": [
        {"path": "zulu-first.md", "properties": {"rank": 1, "team": "Zulu"}},
        {"path": "ada.md", "properties": {"rank": 2, "team": "Ada"}},
        {"path": "zulu-second.md", "properties": {"rank": 3, "team": "Zulu"}},
        {"path": "beta-truncated.md", "properties": {"rank": 4, "team": "Beta"}}
      ],
      "expected": {
        "paths": ["zulu-first.md", "ada.md", "zulu-second.md"],
        "group_names": ["Zulu", "Ada"],
        "group_paths": {
          "Zulu": ["zulu-first.md", "zulu-second.md"],
          "Ada": ["ada.md"]
        }
      }
    }
  ],
  "embedded_case": {
    "id": "embedded-definitions-retain-source-spans",
    "source": "# Overview\r\n\r\n\u0060\u0060\u0060base\r\nviews:\r\n  - type: list\r\n    name: Notes\r\n    unknownView: keep-me\r\n\u0060\u0060\u0060\r\n",
    "expected_count": 1,
    "expected_view": "Notes"
  },
  "unclosed_embedded_case": {
    "id": "unclosed-definition-is-an-issue",
    "source": "~~~base\nviews:\n  - type: list\n",
    "expected_issue": "Embedded base fence is not closed"
  },
  "nested_non_base_outer_fence_case": {
    "id": "base-looking-fence-inside-other-fence-is-ignored",
    "source": "````text\n```base\nviews:\n  - type: list\n    name: Trapped\n```\n````\n",
    "expected_count": 0
  },
  "unicode_prefix_span_case": {
    "id": "embedded-span-offsets-count-utf8-bytes-after-unicode-prefix",
    "source": "🧭 heading\n\n```base\nviews:\n  - type: list\n    name: Notes\n```\n",
    "expected_count": 1,
    "expected_start_byte": 22,
    "expected_end_byte": 60,
    "expected_view": "Notes"
  }
}
