    "PC06": {
      "workflow_id": "workflow:pc06",
      "description": "Inspect an existing repository, review a bounded diff, commit selected files, and project explicit pull/push and conflict handling without invoking a Git process or credential helper.",
      "initial_data": {
        "repository": {
          "path": "Chronicle",
          "branch": "main",
          "remote": "origin",
          "credentialHelper": "os-keychain",
          "dirty": true,
          "staged": true,
          "untracked": true
        },
        "schedule": {
          "pullIntervalMinutes": 30,
          "pushIntervalMinutes": null,
          "automaticPush": false
        },
        "version": 2
      },
      "git_workflow": {
        "repository_path": "Chronicle",
        "default_branch": "main",
        "remote_name": "origin",
        "credential_helper": "os-keychain",
        "status": {
          "expected_branch": "main",
          "expected_dirty_paths": ["Notes/Changed.md"],
          "expected_staged_paths": ["Notes/Staged.md"],
          "expected_untracked_paths": ["Notes/New.md"]
        },
        "diff": {
          "path": "Notes/Changed.md",
          "before": "# Changed\n\nOld body.\n",
          "after": "# Changed\n\nNew body.\n",
          "expected_hunks": 1
        },
        "commit": {
          "selected_paths": ["Notes/Changed.md"],
          "message": "Update compatibility",
          "expected_revision": "abc1234"
        },
        "pull": {
          "remote": "origin",
          "branch": "main",
          "mode": "explicit",
          "expected_result": "fast-forward"
        },
        "push": {
          "remote": "origin",
          "branch": "main",
          "mode": "explicit",
          "expected_result": "pushed"
        },
        "conflict": {
          "path": "Notes/Conflict.md",
          "base": "# Conflict\n\nBase.\n",
          "local": "# Conflict\n\nLocal edit.\n",
          "remote": "# Conflict\n\nRemote edit.\n",
          "local_copy": "Notes/Conflict.local.md",
          "remote_copy": "Notes/Conflict.remote.md",
          "expected_state": "protected"
        },
        "schedule": {
          "pull_interval_minutes": 30,
          "push_interval_minutes": null,
          "automatic_push": false,
          "expected_disposition": "configured-but-not-run"
        },
        "denied_operations": [
          {
            "operation": "git-process",
            "capability": "process.spawn",
            "disposition": "denied",
            "safe_alternative": "mediated Chronicle Git action"
          },
          {
            "operation": "credential-helper",
            "capability": "credentials.read",
            "disposition": "denied",
            "safe_alternative": "preserve the configured helper name without reading credentials"
          }
        ]
      },
      "active_file": "Notes/Changed.md",
      "files": [
        {"path": "Notes/Changed.md", "content": "# Changed\n\nNew body.\n"},
        {"path": "Notes/Staged.md", "content": "# Staged\n\nReady for the selected commit.\n"},
        {"path": "Notes/New.md", "content": "# New\n\nUntracked note.\n"},
        {"path": "Notes/Conflict.md", "content": "# Conflict\n\nLocal edit.\n"}
      ]
    },
    "PC03": {
      "workflow_id": "workflow:pc03",
      "description": "Render a bounded DQL table from frontmatter and inline fields, resolve links and tasks, refresh after an external edit, and deny DataviewJS execution.",
      "initial_data": {
        "indexRefresh": "on-file-change",
        "inlineFieldsEnabled": true,
        "dataviewjsEnabled": false,
        "queryLimit": 50
      },
      "dataview_workflow": {
        "source_folder": "Notes",
        "query": "TABLE status, priority, file.link FROM \"Notes\" WHERE status = \"active\" SORT priority DESC",
        "query_type": "table",
        "expected_columns": ["file.path", "status", "priority", "file.link"],
        "expected_rows": [
          {"path": "Notes/Project.md", "status": "active", "priority": 2, "link": "Notes/Project.md"},
          {"path": "Notes/Second.md", "status": "active", "priority": 1, "link": "Notes/Second.md"}
        ],
        "expected_links": [
          {"source": "Notes/Project.md", "target": "Notes/Second.md"}
        ],
        "expected_tasks": [
          {"path": "Notes/Project.md", "checked": false, "text": "Review compatibility"}
        ],
        "external_edit": {
          "path": "Notes/Second.md",
          "content": "---\nstatus: paused\npriority: 1\n---\n\n# Second\n\n[owner:: Ashutosh]\n",
          "expected_status": "paused"
        },
        "dataviewjs": {
          "source": "return dv.pages('Notes').where(page => page.status === 'active');",
          "capability": "code.dynamic",
          "expected_disposition": "denied",
          "safe_alternative": "bounded DQL projection"
        }
      },
      "active_file": "Notes/Project.md",
      "files": [
        {"path": "Notes/Project.md", "content": "---\nstatus: active\npriority: 2\n---\n\n# Project\n\n[owner:: Ashutosh]\nSee [[Notes/Second]] for context.\n\n- [ ] Review compatibility\n"},
        {"path": "Notes/Second.md", "content": "---\nstatus: active\npriority: 1\n---\n\n# Second\n\n[owner:: Ashutosh]\n"},
        {"path": "Archive/Paused.md", "content": "---\nstatus: paused\npriority: 9\n---\n\n# Paused\n"}
      ]
    },
