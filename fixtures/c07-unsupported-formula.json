{
  "schema_version": 1,
  "id": "fixture:c07-unsupported-formula",
  "description": "Unsupported formulas produce a typed compatibility issue and no fabricated result.",
  "source": {
    "version": 1,
    "views": [
      {
        "type": "list",
        "name": "Notes",
        "formulas": {
          "bad": "date(today)"
        },
        "unknownView": {
          "keep": "view-field"
        }
      }
    ],
    "unknownRoot": {
      "keep": "root-field"
    }
  },
  "view": "Notes",
  "rows": [
    {
      "path": "note.md",
      "properties": {
        "status": "open"
      }
    }
  ],
  "expected": {
    "formula": "bad",
    "issue_kind": "unsupported-formula",
    "issue_expression": "date(today)",
    "issue_message": "Unsupported Bases formula: date(today)"
  },
  "edge_cases": [
    {
      "id": "same-named-note-property-is-not-formula-result",
      "rows": [
        {
          "path": "note.md",
          "properties": {
            "bad": "source-property-value",
            "status": "open"
          }
        }
      ],
      "expected": {
        "row_count": 1,
        "source_property": "source-property-value",
        "formula_value_absent": true,
        "issue_count": 1
      }
    },
    {
      "id": "unsupported-formula-with-empty-source-rows",
      "rows": [],
      "expected": {
        "row_count": 0,
        "issue_count": 1
      }
    },
    {
      "id": "unsupported-formula-when-filter-removes-all-rows",
      "filter": {
        "kind": "comparison",
        "field": "status",
        "operator": "equals",
        "value": "open"
      },
      "rows": [
        {
          "path": "closed.md",
          "properties": {
            "status": "closed"
          }
        }
      ],
      "expected": {
        "row_count": 0,
        "issue_count": 1
      }
    },
    {
      "id": "source-property-collision-does-not-drive-formula-sort",
      "sort": [{"field": "bad", "direction": "asc"}],
      "rows": [
        {
          "path": "z.md",
          "properties": {
            "bad": "first-by-property",
            "status": "open"
          }
        },
        {
          "path": "a.md",
          "properties": {
            "bad": "second-by-property",
            "status": "open"
          }
        }
      ],
      "expected": {
        "row_count": 2,
        "issue_count": 1,
        "paths": ["a.md", "z.md"]
      }
    },
    {
      "id": "source-property-collision-does-not-create-formula-groups",
      "groupBy": "bad",
      "rows": [
        {
          "path": "z.md",
          "properties": {
            "bad": "Zulu source value",
            "status": "open"
          }
        },
        {
          "path": "a.md",
          "properties": {
            "bad": "Ada source value",
            "status": "open"
          }
        }
      ],
      "expected": {
        "row_count": 2,
        "issue_count": 1,
        "paths": ["z.md", "a.md"],
        "group_names": ["None"],
        "group_paths": {
          "None": ["z.md", "a.md"]
        }
      }
    }
  ]
}
