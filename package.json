{
  "name": "openobsidian",
  "version": "0.1.0",
  "private": true,
  "author": "OpenObsidian contributors",
  "description": "An Obsidian-compatible AI workspace for individual power users.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "bun@1.4.2",
  "trustedDependencies": ["electron"],
  "scripts": {
    "status": "bun scripts/status.ts",
    "validate:state": "bun scripts/status.ts --validate",
    "release:check": "bun scripts/status.ts --release",
    "check:fast": "bun scripts/check-fast.ts",
    "test": "bun test",
    "test:bases": "bun test tests/bases.test.ts",
    "typecheck": "bunx tsc --noEmit",
    "compile": "bun run compile:main && bun run compile:preload && bun run compile:renderer",
    "compile:main": "bun build src/electron/main.ts --target=node --outfile=dist/main.js --external electron",
    "compile:preload": "bun build src/electron/preload.ts --target=node --format=cjs --outfile=dist/preload.cjs --external electron",
    "compile:renderer": "bun build src/renderer/renderer.ts --target=browser --outfile=dist/renderer.js",
    "start": "bun run compile && electron .",
    "package:dir": "bun run compile && electron-builder --dir --publish never",
    "validate:architecture": "bun scripts/validate-architecture.ts",
    "validate:contracts": "bun scripts/validate-contracts.ts",
    "validate:surfaces": "bun scripts/validate-ux-surfaces.ts",
    "verify:plugin-selection": "bun scripts/verify-plugin-selection.ts",
    "verify:compatibility-pins": "bun scripts/verify-compatibility-pins.ts",
    "audit:plugin-bundles": "bun scripts/audit-plugin-bundles.ts",
    "audit:plugin-runtime": "bun scripts/audit-plugin-bundles.ts --runtime-probe",
    "audit:plugin-runtime:all": "bun scripts/audit-plugin-bundles.ts --all --runtime-probe",
    "validate:plugin-matrix": "bun scripts/validate-plugin-matrix.ts",
    "verify:version-baseline": "bun scripts/verify-version-baseline.ts",
    "validate:differential": "bun scripts/validate-differential-fixtures.ts",
    "validate:workflows": "bun scripts/validate-core-workflows.ts",
    "verify:primary-references": "bun scripts/verify-primary-references.ts",
    "verify:distribution": "bun scripts/verify-distribution.ts",
    "audit:dependencies": "bun scripts/audit-dependency-attribution.ts",
    "audit:packaged": "bun scripts/audit-packaged-runtime.ts",
    "quality:program": "bun scripts/quality-program.ts",
    "release:gate": "bun scripts/release-gate.ts",
    "release:update-check": "bun scripts/update-rollback.ts",
    "final:audit": "bun scripts/final-audit.ts",
    "check:accessibility": "bun scripts/check-accessibility.ts",
    "validate:layout": "bun scripts/validate-layout.ts",
    "knip": "knip",
    "audit:fallow": "bunx fallow health --root . --format compact --report-only",
    "audit:fallow:health": "bunx fallow health --root . --format compact --report-only",
    "audit:fallow:changed": "bunx fallow audit --root . --base HEAD --format compact --brief",
    "audit:fallow:strict": "bunx fallow audit --root . --base HEAD --format compact",
    "audit:source-tree": "bun scripts/source-tree-digest.ts",
    "quality": "bun run validate:state && bun run final:audit && bun run release:update-check && bun run validate:contracts && bun run validate:plugin-matrix && bun run validate:architecture && bun run verify:version-baseline && bun run validate:differential && bun run validate:workflows && bun run verify:distribution && bun run check:accessibility && bun run validate:layout && bun run typecheck && bun test && bun run quality:program && bun run compile && bun run knip && bun run audit:fallow"
  },
  "build": {
    "appId": "ai.openobsidian.desktop",
    "productName": "OpenObsidian",
    "icon": "assets/openobsidian-icon.png",
    "files": ["assets/**/*", "dist/main.js", "dist/preload.cjs", "dist/renderer.js", "src/renderer/**/*", "package.json"],
    "directories": {"output": "out"},
    "mac": {"target": ["dmg"]},
    "win": {"target": ["nsis"]},
    "linux": {"target": ["AppImage"]}
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "electron": "44.3.0",
    "electron-builder": "26.16.1",
    "knip": "6.35.1",
    "typescript": "7.0.2"
  }
}
