#!/usr/bin/env bash
# Fast local guard against the failures that most often turn CI red.
# This is a convenience only: GitHub Actions remains the sole acceptance evidence
# for the Rust migration, and a local pass never counts as validation.
#
# Checks (staged Rust files only):
#   1. cargo fmt --check        (always)
#   2. cargo clippy -D warnings (set OPENOBSIDIAN_PRECOMMIT_CLIPPY=1; also run by pre-push)
# Skip once with:  git commit --no-verify
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged_rust="$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' 'Cargo.toml' 'Cargo.lock' || true)"
if [ -z "$staged_rust" ]; then
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found; skipping local Rust checks (CI will still run them)." >&2
  exit 0
fi

echo "pre-commit: cargo fmt --all -- --check"
if ! cargo fmt --all -- --check; then
  echo "pre-commit: formatting differs. Run 'cargo fmt --all' and re-stage." >&2
  exit 1
fi

if [ "${OPENOBSIDIAN_PRECOMMIT_CLIPPY:-0}" = "1" ]; then
  echo "pre-commit: cargo clippy --workspace --all-targets --locked -- -D warnings"
  cargo clippy --workspace --all-targets --locked -- -D warnings
fi
